{
  "name": "cyberfriend",
  "description": "CyberFriend desktop app",
  "author": "n1ghts4kura",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "main": "electron-main.js",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:electron": "node scripts/kill-prev.cjs && concurrently -k -n WEB,ELECTRON -c yellow,cyan \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electronmon --inspect=5858 .\"",
    "dist:win": "vite build && electron-builder --win"
  },
  "eslintConfig": {
    "extends": []
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "electron": "^37.4.0",
    "electron-builder": "^24.13.3",
    "concurrently": "^9.0.1",
    "wait-on": "^7.2.0",
    "cross-env": "^7.0.3",
    "electronmon": "^2.0.2",
    "tailwindcss": "^3.4.10",
    "postcss": "^8.4.41",
    "autoprefixer": "^10.4.20",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "@vitejs/plugin-react": "^4.3.1"
  },
  "build": {
    "appId": "com.cyberfriend.app",
    "productName": "CyberFriend",
    "asar": true,
    "directories": {
      "buildResources": "public",
      "output": "dist"
    },
    "files": [
  "dist/**/*",
      "electron-main.js",
      "preload.js",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron-main.js"
    },
    "win": {
  "target": ["nsis"],
  "icon": "public/logo512.png"
    }
  }
}
