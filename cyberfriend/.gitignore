# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Crash reports
report.[0-9]*.log
*.dmp
*.stacktrace

# Electron debug / profile data
*.log
*.pid
*.pid.lock
*.patch
*.orig

# Windows installer output extras
/*.exe.blockmap

# Generated icons (if using electron-builder icon conversion)
icon.icns
icon.ico
app.ico
public/app.ico

# Temp rename folders from clean scripts
dist._old_*/

# Live2D model assets (binary/proprietary) – keep out of VCS; user can place official models locally
public/live2d/models/
!public/live2d/models/.gitkeep

# (Removed earlier rule that ignored entire framework; keep sources so project builds standalone)
# Ignore official Live2D framework sources (users fetch SDK separately). Keep only our wrappers.
src/live2d/framework/**
!src/live2d/framework/live2dcubismframework.js
!src/live2d/framework/frameworkEntry.js
!src/live2d/framework/bootCubism.js
!src/live2d/framework/NO_STUB_README.md


# Generated build analysis (optional):
stats.json
analyze-report.html

# Temporary scratch files
*.swp
*.tmp
~$*
*.bak
*.orig
*.rej

# Package archives
*.tgz

# NPM offline cache
npm-packages-offline-cache/

# Local tooling artifacts
.DS_Store?
*.iml
.idea_modules/

# Live2D temp (export / bake / processing)
public/live2d/tmp/
public/live2d/cache/

# Screenshots / design references (keep a dedicated folder untracked)
screenshots/
